{
  "expo": {
    "name": "Entertainment Express",
    "slug": "ee-crew-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.entertainmentexpress.crew",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.entertainmentexpress.crew",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Entertainment Express to access your location for check-in purposes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3b82f6",
          "sounds": [
            "./assets/notification-sound.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Entertainment Express to access your photos for event documentation."
        }
      ]
    ],
    "owner": "entertainment-express",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/1234567890",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "entertainment-express",
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          {
            "scheme": "https",
            "host": "*.entertainmentexpress.com",
            "pathPrefix": "/shift/"
          }
        ],
        "category": [
          "BROWSABLE",
          "DEFAULT"
        ]
      }
    ],
    "extra": {
      "eas": {
        "projectId": "entertainment-express-crew"
      },
      "apiUrl": "https://api.entertainmentexpress.com",
      "wsUrl": "wss://api.entertainmentexpress.com"
    }
  }
}
